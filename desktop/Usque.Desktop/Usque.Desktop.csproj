<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Usque.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>UsqueDesktop.ico</ApplicationIcon>
    <Version>1.3.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="../Usque.Core/Usque.Core.csproj" />
    <Content Include="Scripts/Network.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="UsqueDesktop.ico" />
  </ItemGroup>
</Project>
