<Window x:Class="Usque.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Usque — WARP for Windows" Width="1060" Height="800" MinWidth="900" MinHeight="600"
        Icon="/Usque.Desktop;component/UsqueDesktop.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#0C1217" FontFamily="Segoe UI"
        UseLayoutRounding="True" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="DiagnosticRowTemplate">
            <Border BorderBrush="#25323A" BorderThickness="0,1,0,0" Padding="0,10">
                <StackPanel>
                    <DockPanel><TextBlock Text="{Binding Result}" DockPanel.Dock="Right" Foreground="#A6C7F5" FontSize="10" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" /></DockPanel>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#8FA6AF" FontSize="10" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Advice}" Style="{StaticResource CollapseWhenEmpty}" TextWrapping="Wrap" Foreground="#F2B66E" FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border BorderThickness="1" BorderBrush="#27323A" FlowDirection="{Binding WindowFlowDirection}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#10191F" BorderBrush="#202C34" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="18,29,18,22">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="7,0,0,0" FlowDirection="LeftToRight">
                        <Border Width="34" Height="34" Background="#67E4BF" CornerRadius="10">
                            <Path Data="M10,9 L10,19 C10,28 24,28 24,19 L24,9" Stroke="#0E3027" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Text="usque" FontSize="25" FontWeight="SemiBold" Margin="10,-3,0,0" />
                    </StackPanel>
                        <Button Click="OnExit" IsEnabled="{Binding CanExit}" BorderBrush="Transparent" Padding="0,8,0,0" Margin="0,12,0,0" HorizontalContentAlignment="Stretch" Foreground="#718B99" FontSize="40" AutomationProperties.Name="{Binding [side.exit]}">
                            <TextBlock Text="{Binding [side.exit]}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding [nav.workspace]}" FontSize="9" Foreground="#5F7683" Margin="14,0,0,17" />
                        <Button Command="{Binding OverviewCommand}" AutomationProperties.Name="{Binding [nav.overview]}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowOverview}" Value="True"><Setter Property="Background" Value="#1C3033" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#67E4BF" Margin="0,2,12,0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding [nav.overview]}" Foreground="#C9F4E7" TextWrapping="Wrap" /></Grid>
                        </Button>
                        <Button Command="{Binding LogsCommand}" AutomationProperties.Name="{Binding [nav.log]}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowLogs}" Value="True"><Setter Property="Background" Value="#1C3033" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#85969F" Margin="0,2,12,0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding [nav.log]}" Foreground="#85969F" TextWrapping="Wrap" /></Grid>
                        </Button>
                        <Button Command="{Binding SettingsCommand}" AutomationProperties.Name="{Binding [nav.settings]}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ShowSettings}" Value="True"><Setter Property="Background" Value="#1C3033" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#85969F" Margin="0,2,12,0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding [nav.settings]}" Foreground="#85969F" FontSize="11" TextWrapping="Wrap" /></Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="10,24,0,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#67E4BF" Margin="0,0,7,0" /><TextBlock Text="{Binding [side.builtOn]}" FontSize="9" Foreground="#9BAFB9" /></StackPanel>
                        <TextBlock Text="{Binding [side.independent]}" Foreground="#586D79" FontSize="10" Margin="0,9,0,0" />
                        <TextBlock Text="{Binding VersionLabel}" Foreground="#586D79" FontSize="10" Margin="0,4,0,0" />
                        <Button Click="OnExit" IsEnabled="{Binding CanExit}" BorderBrush="Transparent" Padding="0,8,0,0" HorizontalContentAlignment="Stretch" Foreground="#718B99" FontSize="40" AutomationProperties.Name="{Binding [side.exit]}">
                            <TextBlock Text="{Binding [side.exit]}" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                        <TextBlock Text="{Binding [header.personal]}" Foreground="#526A78" FontSize="9" />
                        <TextBlock Text=" / " Foreground="#344953" FontSize="10" Margin="9,0" />
                        <TextBlock Text="{Binding PageName}" Foreground="#91A4AF" FontSize="10" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                        <Button Content="—" Width="38" Padding="0" BorderBrush="Transparent" Click="OnMinimize" AutomationProperties.Name="{Binding [action.minimize]}" />
                        <Button Content="×" FontSize="21" Width="38" Padding="0" BorderBrush="Transparent" Click="OnClose" AutomationProperties.Name="{Binding [action.close]}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="32,12,32,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowOverview, Converter={StaticResource VisibleIf}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="80" /><RowDefinition Height="Auto" /><RowDefinition Height="420" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="70" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding [overview.slogan]}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding [overview.sub]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" /></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" CornerRadius="14" BorderBrush="#27353E" BorderThickness="1">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#142128" Offset="0" /><GradientStop Color="#11191F" Offset="0.7" /><GradientStop Color="#10231F" Offset="1" /></LinearGradientBrush></Border.Background>
                        <Grid Margin="24,20,24,0">
                            <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="#AFC5CC" FontSize="13" Margin="0,0,7,0" /><TextBlock Text="{Binding [card.title]}" FontSize="11" Foreground="#AFC5CC" /></StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="9" Background="#1F2C32" Padding="9,4"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{Binding StateBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding Badge}" Foreground="{Binding StateBrush}" FontSize="8" FontWeight="SemiBold" /></StackPanel></Border>
                            </Grid>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <Grid Width="174" Height="174" Margin="0,4,0,0">
                                    <Ellipse Stroke="{Binding StateBrush}" StrokeThickness="1" Opacity="0.12" />
                                    <Ellipse Width="152" Height="152" Stroke="{Binding StateBrush}" StrokeThickness="1" Opacity="0.25" />
                                    <Ellipse Width="164" Height="164" Stroke="{Binding StateBrush}" StrokeThickness="2" StrokeDashArray="5 100" Opacity="0.8" Visibility="{Binding IsBusy, Converter={StaticResource VisibleIf}}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                        <!-- Spin only while busy. An endless storyboard on a collapsed element
                                             still keeps WPF's render loop awake while the app idles in the tray. -->
                                        <Ellipse.Style><Style TargetType="Ellipse"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <DataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:2" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin" /></DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers></Style></Ellipse.Style>
                                    </Ellipse>
                                     <Button Command="{Binding PowerCommand}" Width="128" Height="128" AutomationProperties.Name="{Binding [action.power]}" ToolTip="{Binding PowerHint}">
                                        <Button.Template><ControlTemplate TargetType="Button">
                                            <Border x:Name="PowerSurface" CornerRadius="64" BorderThickness="1.5" BorderBrush="{Binding StateBrush}">
                                                <Border.Background><RadialGradientBrush><GradientStop Color="#253B3E" /><GradientStop Color="#17292D" Offset="1" /></RadialGradientBrush></Border.Background>
                                                <Path Width="46" Height="46" Data="M23,3 L23,23 M12,9 A19,19 0 1 0 34,9" Stroke="{Binding StateBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PowerSurface" Property="Background" Value="#2A4546" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PowerSurface" Property="BorderBrush" Value="White" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PowerSurface" Property="Opacity" Value="0.35" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding PowerHint}" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding Detail}" Foreground="#8FA6AF" TextWrapping="Wrap" FontSize="11" TextAlignment="Center" Margin="14,12,14,8" MaxHeight="48" ToolTip="{Binding Detail}" />
                                <TextBlock Text="{Binding RetryCountdown}" Foreground="#F2B66E" FontSize="11" TextAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Row="2" BorderBrush="#27353D" BorderThickness="0,1,0,0">
                                <UniformGrid Columns="3" VerticalAlignment="Center">
                                    <StackPanel><TextBlock Text="{Binding [stats.protocol]}" FontSize="8" Foreground="#58717E" /><TextBlock Text="{Binding Transport}" FontSize="10" Margin="0,5,0,0" Foreground="#AFC3CD" /></StackPanel>
                                    <StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding [stats.coverage]}" FontSize="8" Foreground="#58717E" /><TextBlock Text="{Binding Coverage}" FontSize="10" Margin="0,5,0,0" Foreground="#AFC3CD" /></StackPanel>
                                    <StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding [stats.session]}" FontSize="8" Foreground="#58717E" /><TextBlock Text="{Binding SessionTime}" FontSize="10" Margin="0,5,0,0" Foreground="#AFC3CD" FontFamily="Consolas" FlowDirection="LeftToRight" /></StackPanel>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Visibility="{Binding ShowConnectionHelp, Converter={StaticResource VisibleIf}}"
                            Margin="0,0,0,12" CornerRadius="10" BorderBrush="#5A4633" BorderThickness="1" Background="#1D1C1A" Padding="18,14"
                            AutomationProperties.Name="{Binding [help.title]}" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <TextBlock Text="{Binding [help.title]}" FontSize="14" FontWeight="SemiBold" Foreground="#F2B66E" />
                            <TextBlock Text="{Binding ConnectionHelpSummary}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding ConnectionHelpAdvice}" Style="{StaticResource CollapseWhenEmpty}" TextWrapping="Wrap" FontSize="11" Foreground="#AFC3CD" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ConnectionHelpProtection}" TextWrapping="Wrap" FontSize="11" Foreground="#F2B66E" Margin="0,8,0,10" />
                            <WrapPanel>
                                <Button Content="{Binding [help.retry]}" Command="{Binding RetryConnectionCommand}" Visibility="{Binding ShowRetryConnection, Converter={StaticResource VisibleIf}}" Margin="0,0,8,6" />
                                <Button Content="{Binding [action.checkNow]}" Command="{Binding CheckHealthCommand}" Visibility="{Binding ShowHealthRetry, Converter={StaticResource VisibleIf}}" Margin="0,0,8,6" />
                                <Button Content="{Binding [diag.run]}" Command="{Binding DiagnoseCommand}" Margin="0,0,8,6" />
                                <Button Content="{Binding [nav.log]}" Command="{Binding LogsCommand}" Margin="0,0,8,6" />
                                <Button Content="{Binding [action.restore]}" Command="{Binding RestoreCommand}" Visibility="{Binding ShowRestoreRecovery, Converter={StaticResource VisibleIf}}" Foreground="#F2B66E" BorderBrush="#5A4633" Margin="0,0,0,6" />
                            </WrapPanel>
                            <Expander Header="{Binding [help.details]}" Foreground="#AFC3CD" Margin="0,6,0,0" AutomationProperties.Name="{Binding [help.details]}">
                                <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" MaxHeight="160" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding [help.details]}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="10" BorderBrush="#25323A" BorderThickness="1" Background="#111B21" Padding="16,10" MinHeight="180">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="44" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <UniformGrid Columns="4">
                                <StackPanel><TextBlock Text="{Binding [stats.download]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding DownloadRate}" FontSize="15" Foreground="#67E4BF" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding [stats.upload]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding UploadRate}" FontSize="15" Foreground="#A6C7F5" Margin="0,4,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding [stats.downloaded]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding DownloadTotal}" FontSize="13" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding [stats.uploaded]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding UploadTotal}" FontSize="13" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                <StackPanel><TextBlock Text="{Binding [stats.latency]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding Latency}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                <StackPanel><TextBlock Text="{Binding [stats.reconnects]}" FontSize="8" Foreground="#718B99" /><TextBlock Text="{Binding Reconnects}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                <TextBlock Text="{Binding LastSuccessfulCheck}" FontSize="9" TextWrapping="Wrap" Foreground="#718B99" VerticalAlignment="Center" />
                            </UniformGrid>
                            <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding HealthSummary}" FontSize="9" Foreground="#8FA6AF" TextWrapping="Wrap" /><TextBlock Text="{Binding HealthCheckedAt}" FontSize="8" Foreground="#58717E" Margin="0,3,0,0" /></StackPanel>
                                <Button Grid.Column="1" Content="{Binding [action.checkNow]}" Command="{Binding CheckHealthCommand}" FontSize="10" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Margin="0,16,0,0" CornerRadius="10" BorderBrush="#25323A" BorderThickness="1" Background="#111B21" Padding="18,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Text="{Binding [mode.label]}" FontSize="12" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [mode.label]}" /></Grid>
                            <TextBlock Text="{Binding ModeDescription}" Foreground="#F2B66E" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <StackPanel Visibility="{Binding IsProxy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,14">
                                <DockPanel><Button Content="{Binding [proxy.copy]}" Command="{Binding CopyProxyCommand}" DockPanel.Dock="Right" /><TextBlock Text="{Binding ProxyAddress}" FontFamily="Consolas" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DockPanel>
                                <TextBlock Text="{Binding TrafficNote}" TextWrapping="Wrap" Foreground="#718B99" FontSize="10" Margin="0,7,0,0" />
                            </StackPanel>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [settings.killSwitchLabel]}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding ProtectionDescription}" Foreground="#718B99" FontSize="10" Margin="0,5,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding KillSwitchSelection}" IsEnabled="{Binding CanConfigureKillSwitch}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.killSwitchLabel]}" /></Grid>
                            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [settings.connectionMode]}" FontSize="11" /><TextBlock Text="{Binding [settings.connectionModeHint]}" Foreground="#718B99" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding TransportChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PreferredTransport}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.preferredTransport]}" /></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [settings.language]}" FontSize="11" /><TextBlock Text="{Binding [settings.languageHint]}" Foreground="#718B99" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Display" SelectedValuePath="Language" SelectedValue="{Binding Language}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.language]}" /></Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="5" Margin="0,16,0,0" CornerRadius="10" BorderBrush="#25323A" BorderThickness="1" Background="#111B21" Padding="18,14">
                        <StackPanel>
                            <DockPanel><Button Content="{Binding [diag.run]}" Command="{Binding DiagnoseCommand}" DockPanel.Dock="Right" /><TextBlock Text="{Binding [settings.health]}" FontSize="13" VerticalAlignment="Center" /></DockPanel>
                            <TextBlock Text="{Binding DiagnosticCheckedAt}" Foreground="#718B99" FontSize="10" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding DiagnosticChecks}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProfileDescription}" FontSize="10" Foreground="#7B919E" TextWrapping="Wrap" Margin="0,0,12,0" /><TextBlock Text="{Binding [profile.privateNote]}" FontSize="9" Foreground="#4E6876" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ImportCommand}" Content="{Binding [action.importProfile]}" HorizontalAlignment="Right" ToolTip="{Binding [action.importHint]}" />
                    </Grid>
                    <Grid Grid.Row="7">
                        <TextBlock Text="{Binding [foot.unaffiliated]}" Foreground="#496371" FontSize="9" VerticalAlignment="Bottom" />
                        <Button Content="{Binding [foot.terms]}" Command="{Binding TermsCommand}" BorderBrush="Transparent" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="#6F8997" />
                    </Grid>
                </Grid>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="32,20,32,30" Visibility="{Binding ShowLogs, Converter={StaticResource VisibleIf}}">
                    <Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{Binding [logs.title]}" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{Binding [logs.subtitle]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding Logs, Mode=OneWay}" TextChanged="OnLogChanged" IsVisibleChanged="OnLogVisibilityChanged" AutomationProperties.Name="{Binding [logs.title]}" IsReadOnly="True" Background="#10191F" Foreground="#A3BDC5" BorderBrush="#27353E" Padding="16" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" />
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{Binding [logs.export]}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,6" /><Button Content="{Binding [logs.clear]}" Command="{Binding ClearLogsCommand}" Margin="0,0,8,6" /><Button Content="{Binding [logs.copy]}" Command="{Binding CopyLogsCommand}" Margin="0,0,0,6" /></WrapPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="32,20,32,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowSettings, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="{Binding [settings.title]}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding [settings.subtitle]}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,22" TextWrapping="Wrap" />
                        <Border Background="#111B21" BorderBrush="#25323A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings.connection]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><TextBlock Text="{Binding [mode.label]}" FontSize="12" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [mode.label]}" /></Grid>
                                <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap" Foreground="#F2B66E" FontSize="10" Margin="0,0,0,14" />
                                <StackPanel Visibility="{Binding IsProxy, Converter={StaticResource VisibleIf}}" Margin="0,0,0,14">
                                    <DockPanel><TextBlock Text="{Binding [proxy.port]}" VerticalAlignment="Center" /><TextBox Text="{Binding ProxyPortText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsEnabled="{Binding CanEdit}" Width="100" Margin="12,0,0,0" MaxLength="5" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding [proxy.port]}" AutomationProperties.HelpText="{Binding ProxyPortError}" /></DockPanel>
                                    <TextBlock Text="{Binding ProxyPortError}" Foreground="#F2B66E" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,10,0,0"><Button Content="{Binding [proxy.copy]}" Command="{Binding CopyProxyCommand}" DockPanel.Dock="Right" /><TextBlock Text="{Binding ProxyAddress}" FontFamily="Consolas" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DockPanel>
                                    <TextBlock Text="{Binding [proxy.usage]}" TextWrapping="Wrap" Foreground="#718B99" FontSize="10" Margin="0,8,0,0" />
                                </StackPanel>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [settings.killSwitchLabel]}" FontSize="12" /><TextBlock Text="{Binding ProtectionDescription}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding KillSwitchSelection}" IsEnabled="{Binding CanConfigureKillSwitch}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.killSwitchLabel]}" /></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [recovery.label]}" FontSize="12" /><TextBlock Text="{Binding [recovery.hint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoReconnect}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [recovery.label]}" /></Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [settings.preferredTransport]}" FontSize="12" /><TextBlock Text="{Binding [settings.autoHint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding TransportChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding PreferredTransport}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [settings.preferredTransport]}" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding [settings.language]}" FontSize="12" /><TextBlock Text="{Binding [settings.languageHint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" DisplayMemberPath="Display" SelectedValuePath="Language" SelectedValue="{Binding Language}" AutomationProperties.Name="{Binding [settings.language]}" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#111B21" BorderBrush="#25323A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings.background]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [settings.minimize]}" FontSize="12" /><TextBlock Text="{Binding [settings.minimizeHint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding MinimizeToTray}" IsEnabled="{Binding CanChangeWindowBehavior}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.minimize]}" /></Grid>
                                <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [settings.autoconnect]}" FontSize="12" /><TextBlock Text="{Binding [settings.autoconnectHint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding AutoConnect}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.autoconnect]}" /></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding [settings.startup]}" FontSize="12" /><TextBlock Text="{Binding [settings.startupHint]}" FontSize="10" Foreground="#718B99" Margin="0,4,12,0" TextWrapping="Wrap" /></StackPanel><CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanConfigureStartup}" VerticalAlignment="Center" AutomationProperties.Name="{Binding [settings.startup]}" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#111B21" BorderBrush="#25323A" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings.profiles]}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding [settings.profilesHint]}" Foreground="#718B99" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProfileId}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,12" AutomationProperties.Name="{Binding [settings.profiles]}" />
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" MaxLength="40" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding [profile.name]}" AutomationProperties.HelpText="{Binding ProfileNameError}" /><Button Grid.Column="1" Content="{Binding [action.importCredentials]}" Command="{Binding ImportCommand}" Margin="10,0,0,0" /></Grid>
                                <TextBlock Text="{Binding ProfileNameError}" Foreground="#F2B66E" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <WrapPanel><Button Content="{Binding [settings.createProfile]}" Command="{Binding CreateProfileCommand}" ToolTip="{Binding CreateProfileNameError}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,6" /><Button Content="{Binding [settings.renameProfile]}" Command="{Binding RenameProfileCommand}" Margin="0,0,8,6" /><Button Content="{Binding [settings.deleteProfile]}" Command="{Binding DeleteProfileCommand}" Foreground="#F2B66E" Margin="0,0,0,6" /></WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="#111B21" BorderBrush="#25323A" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel><TextBlock Text="{Binding [settings.health]}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding HealthSummary}" Foreground="#8FA6AF" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,4" /><TextBlock Text="{Binding Latency}" Foreground="#718B99" FontSize="10" /><TextBlock Text="{Binding [settings.diagnosticsNote]}" Foreground="#718B99" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,12" /><StackPanel Orientation="Horizontal"><Button Content="{Binding [diag.run]}" Command="{Binding DiagnoseCommand}" Margin="0,0,8,0" /><Button Content="{Binding [settings.exportReport]}" Command="{Binding ExportDiagnosticsCommand}" /></StackPanel><TextBlock Text="{Binding DiagnosticCheckedAt}" Foreground="#718B99" FontSize="10" Margin="0,12,0,8" /><ItemsControl ItemsSource="{Binding DiagnosticChecks}" ItemTemplate="{StaticResource DiagnosticRowTemplate}" /></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" /></Storyboard></BeginStoryboard></EventTrigger>
    </Window.Triggers>
</Window>
